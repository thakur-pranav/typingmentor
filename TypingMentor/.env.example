# ── SERVER CONFIGURATION (server/.env or Cloud Service Environment) ──
PORT=5000
NODE_ENV=production
# MongoDB connection string (e.g., MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/typingmentor?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_jwt_secret_key_32_chars
JWT_EXPIRES_IN=7d
# Production frontend URL(s) — comma-separated if multiple domains/preview branches
CLIENT_URL=https://typingmentor.vercel.app

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Transactional Email (Brevo HTTPS REST API or standard SMTP)
BREVO_API_KEY=xkeysib-your-brevo-api-key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
SMTP_FROM="TypingMentor" <support@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# ── CLIENT CONFIGURATION (client/.env.local or Vercel Environment Variables) ──
# Production backend API URL
NEXT_PUBLIC_API_URL=https://typingmentor-api.onrender.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
